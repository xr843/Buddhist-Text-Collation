# ==========================================
# 佛典标点与校勘研究平台 - 环境配置示例
# ==========================================
# 复制此文件为 .env 并根据需要修改

# 应用配置
# -------------------------------------------
APP_NAME="佛典标点与校勘研究平台"
APP_VERSION="2.0.0"
API_V1_PREFIX="/api/v1"
DEBUG=true

# 服务器配置
# -------------------------------------------
HOST=0.0.0.0
PORT=8000

# 数据库配置（暂不需要）
# -------------------------------------------
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/buddhist_text"
DB_ECHO=false

# Redis配置（暂不需要）
# -------------------------------------------
REDIS_URL="redis://localhost:6379/0"

# 安全配置
# -------------------------------------------
# ⚠️ 必填！用 `python -c "import secrets; print(secrets.token_urlsafe(48))"` 生成
SECRET_KEY="REPLACE-WITH-RANDOM-48-BYTE-URLSAFE-TOKEN"
ALGORITHM="HS256"

# CORS配置
# -------------------------------------------
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://localhost:5173"]'

# 数据导入安全配置
# -------------------------------------------
# 图片下载 host 白名单（逗号分隔）。为空表示不限制（仅建议在内网/已启用 API_KEY 的环境使用）。
# 示例：IMPORT_IMAGE_ALLOWED_HOSTS="iiif.example.org,images.example.org"
IMPORT_IMAGE_ALLOWED_HOSTS=""

# 文本处理配置
# -------------------------------------------
MAX_TEXT_LENGTH=50000

# 日志配置
# -------------------------------------------
LOG_LEVEL="INFO"
LOG_FILE="logs/app.log"

