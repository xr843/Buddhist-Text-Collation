# ==========================================
# 佛典标点与校勘研究平台 - 环境配置示例
# ==========================================
# 复制此文件为 .env 并根据需要修改

# 应用配置
# -------------------------------------------
APP_NAME="佛典标点与校勘研究平台"
APP_VERSION="2.0.0"
API_V1_PREFIX="/api/v1"
DEBUG=true

# 服务器配置
# -------------------------------------------
HOST=0.0.0.0
PORT=8000

# 数据库配置（暂不需要）
# -------------------------------------------
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/buddhist_text"
DB_ECHO=false

# Redis配置（暂不需要）
# -------------------------------------------
REDIS_URL="redis://localhost:6379/0"

# 安全配置
# -------------------------------------------
# ⚠️ 必填！用 `python -c "import secrets; print(secrets.token_urlsafe(48))"` 生成
SECRET_KEY="REPLACE-WITH-RANDOM-48-BYTE-URLSAFE-TOKEN"
ALGORITHM="HS256"

# CORS配置
# -------------------------------------------
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://localhost:5173"]'

# 数据导入安全配置
# -------------------------------------------
# 图片下载 host 白名单（逗号分隔）。为空表示不限制（仅建议在内网/已启用 API_KEY 的环境使用）。
# 示例：IMPORT_IMAGE_ALLOWED_HOSTS="iiif.example.org,images.example.org"
IMPORT_IMAGE_ALLOWED_HOSTS=""

# 文本处理配置
# -------------------------------------------
MAX_TEXT_LENGTH=50000

# 古籍酷（gj.cool）OCR 配置
# -------------------------------------------
# 接入古籍酷古籍 OCR API（图片→文字）。两段式：登录在中心化的 ocr.gj.cool，
# 识别在账户专属 worker（见账户「演示」页古籍OCR 的 URL，如 https://ap2.jzd.cool:9043）。
# apiid 是账户专属标识（账户页「API ID」），不是登录用户名。三项凭据都填了 OCR tab 才会启用。
OCR_ENABLED=true
GJCOOL_OCR_BASE_URL=""                       # 识别 worker，如 https://ap2.jzd.cool:9043
GJCOOL_OCR_LOGIN_BASE_URL="https://ocr.gj.cool"
GJCOOL_OCR_APIID=""
GJCOOL_OCR_PASSWORD=""
# worker 证书若过期/不被信任，临时设 false 关闭 TLS 校验（对方续期后改回 true）
GJCOOL_OCR_VERIFY_SSL=true
# 单次 OCR 请求超时（秒）/ 上传图片大小上限（字节，默认 20MB）
GJCOOL_OCR_TIMEOUT=120
OCR_MAX_UPLOAD_SIZE=20971520

# 日志配置
# -------------------------------------------
LOG_LEVEL="INFO"
LOG_FILE="logs/app.log"

